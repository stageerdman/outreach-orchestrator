# Copy to .env and fill in.

# --- CRM (people to reach out to) ---
# Endpoint returning a JSON list of people. Leave empty to use data/people.sample.json.
CRM_URL=
CRM_TOKEN=
# CRM_AUTH_HEADER=Authorization
# CRM_AUTH_PREFIX="Bearer "
# Supabase-style login (e.g. ResultsON): log in with email/password for a fresh
# token on every refresh, sending CRM_APIKEY as the `apikey` header.
# CRM_LOGIN_URL=https://<project>.supabase.co/auth/v1/token?grant_type=password
# CRM_APIKEY=<publishable key>
# CRM_LOGIN_EMAIL=
# CRM_LOGIN_PASSWORD=
# ResultsON "my open tasks" (one contact per open task assigned to you):
# CRM_URL=https://<project>.supabase.co/rest/v1/contacts?select=id,name,email,phone_e164,funnel,tasks!inner(id)&tasks.assigned_to=eq.<your team_members.id>&tasks.status=eq.open
# CRM_PHONE_FIELD=phone_e164
# CRM_COMPANY_FIELD=funnel
# If the list is nested in the response, e.g. { "data": { "items": [...] } }:
# CRM_LIST_PATH=data.items
# Map your CRM's field names (dot paths allowed). Email/phone may be a string or a list.
# CRM_ID_FIELD=id
# CRM_NAME_FIELD=name
# CRM_COMPANY_FIELD=company
# CRM_EMAIL_FIELD=email
# CRM_PHONE_FIELD=phone

# --- Email (IMAP) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
# Use an app password, not your main password.
IMAP_PASS=
# Only needed if the server doesn't flag its Sent folder:
# IMAP_SENT_FOLDER=Sent

# --- WhatsApp (whatsapp-mcp bridge) ---
# Defaults to vendor/whatsapp-mcp/whatsapp-bridge/store/messages.db
# WHATSAPP_DB=

PORT=3000
