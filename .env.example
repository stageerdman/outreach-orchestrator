# Copy to .env and fill in.

# --- CRM: ResultsON (takes precedence over CRM_URL) ---
# People = contacts with an open task assigned to you, grouped by pipeline stage.
# RESULTSON_URL=https://<project>.supabase.co
# RESULTSON_APIKEY=<publishable key>
# RESULTSON_EMAIL=<team-member login>
# RESULTSON_PASSWORD=

# --- Other CRM (people to reach out to) ---
# Endpoint returning a JSON list of people. Leave empty to use data/people.sample.json.
CRM_URL=
CRM_TOKEN=
# CRM_AUTH_HEADER=Authorization
# CRM_AUTH_PREFIX="Bearer "
# If the list is nested in the response, e.g. { "data": { "items": [...] } }:
# CRM_LIST_PATH=data.items
# Map your CRM's field names (dot paths allowed). Email/phone may be a string or a list.
# CRM_ID_FIELD=id
# CRM_NAME_FIELD=name
# CRM_COMPANY_FIELD=company
# CRM_EMAIL_FIELD=email
# CRM_PHONE_FIELD=phone

# --- Email (IMAP) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
# Use an app password, not your main password.
IMAP_PASS=
# Only needed if the server doesn't flag its Sent folder:
# IMAP_SENT_FOLDER=Sent

# --- WhatsApp (whatsapp-mcp bridge) ---
# Defaults to vendor/whatsapp-mcp/whatsapp-bridge/store/messages.db
# WHATSAPP_DB=

PORT=3000
